---
import { getChannel, path } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const channel = await getChannel();
const { title, description = channel.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${channel.name}` : channel.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="site-name" href={path('/')}><span class="prompt">~/</span>{channel.name}</a>
        <nav>
          <a href={path('/about/')}>About</a>
          <a href={path('/drafts/')}>Drafts</a>
          <a href={`https://github.com/${channel.repo}`}>Source</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        {channel.links.map((link) => <a href={link.url}>{link.label}</a>)}
        <a href={path('/about/')}>About</a>
        <p class="fine-print">Writing and media CC BY 4.0, code MIT.</p>
      </footer>
    </div>
  </body>
</html>
