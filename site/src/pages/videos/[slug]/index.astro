---
import { getEntry, render } from 'astro:content';
import { toSeconds } from '../../../../../tools/lib/rules.ts';
import { githubEditUrl } from '../../../../../tools/lib/urls.ts';
import Base from '../../../layouts/Base.astro';
import { getChannel, videosWithStatus } from '../../../lib/site';

export async function getStaticPaths() {
  const videos = await videosWithStatus('published');
  return videos.map((video) => ({ params: { slug: video.id }, props: { video } }));
}

const { video } = Astro.props;
const { title, youtube_id, publish_date, sample } = video.data;

const channel = await getChannel();
const chapters = (await getEntry('chapters', video.id))?.data.chapters ?? [];
const writeup = await getEntry('writeups', video.id);
const { Content, headings } = writeup ? await render(writeup) : { Content: undefined, headings: [] };

// Headings get wrapped in a link to their matching chapter's point in the video, client-side
// (Content is opaque rendered HTML, so matching happens by id after the DOM exists).
const chapterLinks = sample
  ? {}
  : Object.fromEntries(
      headings.flatMap(({ slug, text }) => {
        const chapter = chapters.find((c) => c.title.toLowerCase() === text.toLowerCase());
        return chapter ? [[slug, `https://youtu.be/${youtube_id}?t=${toSeconds(chapter.time)}`]] : [];
      }),
    );
---

<Base title={title}>
  <h1>{title}</h1>
  <time class="meta" datetime={publish_date}>{publish_date}</time>

  {
    sample ? (
      <div class="player player-placeholder">The video player appears here for real videos.</div>
    ) : (
      <iframe
        class="player"
        src={`https://www.youtube-nocookie.com/embed/${youtube_id}`}
        title={title}
        loading="lazy"
        allow="encrypted-media; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      />
    )
  }

  <div class="writeup">{Content && <Content />}</div>

  <p>
    <a href={githubEditUrl(channel, `videos/${video.id}/writeup.md`)}>Edit this page on GitHub</a>
  </p>
</Base>

{Object.keys(chapterLinks).length > 0 && <script type="application/json" id="chapter-links" set:html={JSON.stringify(chapterLinks)} />}

<script>
  const chapterLinks: Record<string, string> = JSON.parse(document.getElementById('chapter-links')?.textContent ?? '{}');

  for (const heading of document.querySelectorAll<HTMLHeadingElement>('.writeup :is(h2, h3)[id]')) {
    const href = chapterLinks[heading.id];
    if (!href) continue;
    const anchor = document.createElement('a');
    anchor.href = href;
    anchor.target = '_blank';
    anchor.rel = 'noopener';
    anchor.className = 'heading-anchor';
    anchor.append(...heading.childNodes);
    heading.replaceChildren(anchor);
  }
</script>
