---
import Base from '../layouts/Base.astro';
import { getChannel, path, videosWithStatus } from '../lib/site';

const channel = await getChannel();
const videos = await videosWithStatus('published');
---

<Base>
  <p class="kicker">YouTube channel</p>
  <h1>{channel.name}</h1>
  <p class="lede">{channel.description}</p>

  <h2>Videos</h2>
  {videos.length === 0 && <p>Nothing published yet.</p>}
  <ul class="video-list">
    {
      videos.map((video) => (
        <li>
          <a class="card" href={path(`/videos/${video.id}/`)}>
            <span class="title">{video.data.title}</span>
            <time class="meta" datetime={video.data.publish_date}>{video.data.publish_date}</time>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
