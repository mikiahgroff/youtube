{
  "name": "youtube",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public source of truth for the mikiahgroff YouTube channel.",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "validate": "tsx tools/validate.ts",
    "preview": "tsx tools/build-description.ts",
    "sync": "tsx tools/sync.ts",
    "auth": "tsx tools/auth.ts",
    "test": "tsx --test \"tools/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "site:dev": "npm run dev -w site",
    "site:build": "npm run build -w site",
    "site:preview": "npm run preview -w site"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "googleapis": "^189.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
